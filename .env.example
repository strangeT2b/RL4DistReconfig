# Copy this file to .env and fill in private values on the machine that runs training.
# .env is ignored by git and is loaded automatically by scripts/env_cache_disk2.sh.

# Base model locations. Override these per machine after copying to .env.
LLAMA31_BASE_MODEL=../models/meta-llama/Llama-3.1-8B
LLAMA31_INSTRUCT_MODEL=../models/meta-llama/Llama-3.1-8B-Instruct
QWEN3_8B_MODEL=../models/Qwen/Qwen3-8B

# Enable W&B in the training command with: --report_to wandb
WANDB_API_KEY=
WANDB_PROJECT=RL4DistReconfig
WANDB_ENTITY=

# Optional W&B behavior:
# WANDB_MODE=offline
